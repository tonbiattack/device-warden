<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">
  <!-- The identity and publisher are development placeholders, not Store identity. -->
  <Identity Name="Tonbiattack.DeviceWarden.Dev" Publisher="CN=Device Warden Development" Version="0.2.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Device Warden (Development)</DisplayName>
    <PublisherDisplayName>Device Warden Development</PublisherDisplayName>
    <Description>Local Android device lease manager</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources><Resource Language="ja-jp" /></Resources>
  <Applications>
    <Application Id="App" Executable="DeviceWardenMsixDev\DeviceWardenMsixDev.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Device Warden (Development)" Description="Local Android device lease manager"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="DeviceWardenMsixDev\DeviceWardenMsixDev.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DeviceWardenStartup" Enabled="false" DisplayName="Device Warden" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
</Package>

